# Variables del Sistema de Seguimiento Académico
# ---------------------------------------------------------------------------
# Este archivo es la LISTA, no las claves: no lleva ningún valor real y sí puede
# acompañar al código. Las claves de verdad viven en el .env de la computadora
# del colegio y, en el servidor, en las Variables de Railway.

# ── obligatorias ──
# Una cadena larga y única. Para generar una nueva:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=
# En el servidor SIEMPRE False. Con True, cualquier error muestra el código y
# las claves a quien esté mirando.
DEBUG=False

# ── base de datos ──
# En Railway: una sola variable, que se conecta desde el propio panel
# (Variables → Add Reference → Postgres → DATABASE_URL).
# DATABASE_URL=postgresql://usuario:clave@host:5432/basededatos
#
# En la computadora del colegio: los cinco datos sueltos.
DB_NAME=seguimiento_academico
DB_USER=academico_app
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ── direcciones ──
# En Railway no hace falta: el dominio lo pone el propio servidor.
ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://colegio.ejemplo.edu.bo

# ── avisos al celular ──
# Se generan una sola vez y no se cambian: si cambian, todos los teléfonos que
# ya activaron los avisos dejan de recibirlos y hay que volver a activarlos.
#   python -m py_vapid --gen
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACTO=mailto:direccion@ejemplo.edu.bo

# ── correo ──
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# ── reglas del colegio ──
UMBRAL_FALTAS_ALERTA=3
UMBRAL_TAREAS_SIN_ENTREGAR=3
HORA_ENTRADA=13:50

# ── copias de respaldo ──
# RESPALDOS_DIR=E:\Respaldos Seguimiento
# RESPALDOS_COPIA=D:\Respaldos Seguimiento
# RESPALDOS_DIAS=14
# RESPALDOS_MESES=12
# PG_BIN=C:\Program Files\PostgreSQL\16\bin

# ── archivos subidos ──
# En Railway: la carpeta donde se monta el Volume.
# MEDIA_ROOT=/app/media
